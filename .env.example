APP_NAME="Happy Tails Dog Clinic"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# SQLite works out of the box. For MySQL set DB_CONNECTION=mysql and fill the DB_* values.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=happy_tails
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
# SESSION_SECURE_COOKIE defaults to true in production and false locally.
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Emails (email verification). "log" writes messages to storage/logs for local testing.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@happytails.test"
MAIL_FROM_NAME="${APP_NAME}"

# Optional: used by `php artisan db:seed` to create the initial admin when the email is unused.
ADMIN_EMAIL=
ADMIN_PASSWORD=
