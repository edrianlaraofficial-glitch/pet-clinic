APP_NAME="Happy Tails Dog Clinic"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# SQLite works out of the box for local development.
DB_CONNECTION=sqlite
# For Supabase PostgreSQL, set DB_CONNECTION=pgsql and use the values from
# the Supabase Dashboard's Connect dialog. Never commit production credentials.
# DB_HOST=
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=
# DB_PASSWORD=
# DB_SCHEMA=public
# DB_SSLMODE=require

SESSION_DRIVER=file
SESSION_LIFETIME=120
# SESSION_SECURE_COOKIE defaults to true in production and false locally.
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Mail is used for password resets and administrator email changes.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@happytails.test"
MAIL_FROM_NAME="${APP_NAME}"

# Optional: used by `php artisan db:seed` to create the initial admin when the email is unused.
ADMIN_EMAIL=edrianlara.official@gmail.com
ADMIN_PASSWORD=ShadowByte@261

# Temporarily set a random 64-character value for one-time first-admin setup.
$key = [Convert]::ToHexString([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
"ADMIN_SETUP_KEY=$key"
